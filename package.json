{
	"name": "nano-cli-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.13"
	},
	"bin": {
		"nano-cli-agent": "./dist/cli.js"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"lint": "eslint src --max-warnings 0",
		"lint:fix": "eslint src --fix --max-warnings 0",
		"check": "pnpm lint && biome check . && tsc -p tsconfig.json"
	},
	"dependencies": {
		"@ai-sdk/openai": "^2.0.72",
		"ai": "^5.0.102",
		"dotenv": "^17.2.3",
		"ink": "^6.5.1",
		"ink-spinner": "^5.0.0",
		"react": "^19.2.0",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^6.0.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"eslint": "^10.15.0",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.74.0"
	}
}
